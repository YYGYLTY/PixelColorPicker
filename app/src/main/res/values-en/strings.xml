    <string name="about_version">Version 2.0 · Jetpack Compose</string>
    <string name="about_what_title">What is this</string>
    <string name="about_what_body">PixelColorPicker is a local image pixelation tool: crop any image and convert it into pixel art of any size (1–999), inspect every cell\'s color, and generate palette codes compatible with the original app.</string>
    <string name="about_flow_title">How to use</string>
    <string name="about_flow_body">1. Set the canvas size on Home\n2. Tap the display box, pick an image and crop to the canvas ratio\n3. Fine-tune position / size / rotation and choose an algorithm\n4. Tap \"Generate pixel art\"\n5. Inspect colors on the Palette tab, copy per-column codes on the Code tab</string>
    <string name="about_codec_title">16-color palette protocol</string>
    <string name="about_codec_body">Each column samples 16 pixel colors (padded with white if shorter), plus 2 white colors — 18 colors total, encoded as Protobuf bytes + GZIP + standard Base64.</string>
    <string name="about_privacy_title">Privacy</string>
    <string name="about_privacy_body">All processing happens on device. No network, no uploads, no storage permissions (uses the system photo picker).</string>
    <string name="about_credits_title">Credits</string>
    <string name="about_credits_body">A remake built by Astnote in collaboration with AI.</string>

